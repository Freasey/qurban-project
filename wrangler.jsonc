{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qurban-project",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qurban",
      "database_id": "af7cdb26-3917-49c8-8c68-fa90287818e9"
    }
  ],
  // ADMIN_EMAIL, ADMIN_PASSWORD, dan SESSION_SECRET diisi di dashboard Cloudflare
  // (Workers & Pages → qurban-project → Settings → Variables and Secrets).
  // keep_vars: deploy berikutnya tidak menghapus variabel yang diisi lewat dashboard.
  "keep_vars": true
}
