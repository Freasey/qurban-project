# Akun admin (satu-satunya). Password disimpan apa adanya (tanpa hash) supaya mudah diganti.
ADMIN_EMAIL=admin@masjid.local
ADMIN_PASSWORD=ganti-password-ini

# Opsional. Kunci tambahan untuk menandatangani cookie sesi admin.
SESSION_SECRET=

# Cloudflare D1 (SQLite). Kalau kosong saat development lokal, dipakai file .data/local.db
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# API token dengan izin Account → D1 → Edit
CLOUDFLARE_API_TOKEN=
