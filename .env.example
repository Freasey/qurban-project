# Akun admin (satu-satunya). Password disimpan apa adanya (tanpa hash) supaya mudah diganti.
ADMIN_EMAIL=admin@masjid.local
ADMIN_PASSWORD=ganti-password-ini

# Opsional. Kunci untuk menandatangani cookie sesi admin.
# Kalau kosong, dibuat dari ADMIN_EMAIL + ADMIN_PASSWORD.
SESSION_SECRET=

# Postgres (Neon). Di Vercel otomatis terisi saat database Neon dihubungkan ke project.
# Kalau kosong saat development lokal, aplikasi memakai PGlite (Postgres embedded) di folder .data/
DATABASE_URL=
